#pragma once
#include <cstddef>
#include <new>
#include <utility>

namespace std {

template <class T>
struct default_delete {
    constexpr default_delete() noexcept = default;
    template <class U>
    default_delete(const default_delete<U>&) noexcept {}
    void operator()(T* ptr) const { delete ptr; }
};

template <class T, class Deleter = default_delete<T>>
class unique_ptr {
    T* m_ptr = nullptr;
    Deleter m_del{};
public:
    constexpr unique_ptr() noexcept = default;
    constexpr unique_ptr(nullptr_t) noexcept : m_ptr(nullptr) {}
    explicit unique_ptr(T* p) noexcept : m_ptr(p) {}
    unique_ptr(T* p, Deleter d) noexcept : m_ptr(p), m_del(move(d)) {}
    unique_ptr(unique_ptr&& o) noexcept : m_ptr(o.release()), m_del(move(o.m_del)) {}
    unique_ptr(const unique_ptr&) = delete;
    unique_ptr& operator=(const unique_ptr&) = delete;

    unique_ptr& operator=(unique_ptr&& o) noexcept {
        if (this != &o) { reset(o.release()); m_del = move(o.m_del); }
        return *this;
    }
    unique_ptr& operator=(nullptr_t) noexcept { reset(); return *this; }
    ~unique_ptr() { reset(); }

    T* get() const noexcept { return m_ptr; }
    T& operator*() const { return *m_ptr; }
    T* operator->() const noexcept { return m_ptr; }
    explicit operator bool() const noexcept { return m_ptr != nullptr; }
    T* release() noexcept { T* p = m_ptr; m_ptr = nullptr; return p; }
    void reset(T* p = nullptr) noexcept {
        if (m_ptr) m_del(m_ptr);
        m_ptr = p;
    }
};

namespace detail {
struct sp_ctrl_base {
    long refs = 1;
    virtual void dispose() noexcept = 0;
    virtual ~sp_ctrl_base() noexcept = default;
};

template <class T, class Deleter>
struct sp_ctrl_del final : sp_ctrl_base {
    T* ptr;
    Deleter del;
    sp_ctrl_del(T* p, Deleter d) : ptr(p), del(move(d)) {}
    void dispose() noexcept override {
        if (ptr) del(ptr);
        ptr = nullptr;
    }
};

template <class T>
struct sp_ctrl_obj final : sp_ctrl_base {
    alignas(T) unsigned char storage[sizeof(T)];
    bool alive = false;
    T* ptr() noexcept { return reinterpret_cast<T*>(storage); }
    template <class... Args>
    explicit sp_ctrl_obj(Args&&... args) {
        ::new (static_cast<void*>(storage)) T(forward<Args>(args)...);
        alive = true;
    }
    void dispose() noexcept override {
        if (alive) { ptr()->~T(); alive = false; }
    }
};
} // namespace detail

template <class T>
class shared_ptr {
    T* m_ptr = nullptr;
    detail::sp_ctrl_base* m_ctrl = nullptr;

    template <class U> friend class shared_ptr;
    template <class U, class... Args> friend shared_ptr<U> make_shared(Args&&...);

    void inc() noexcept {
        if (m_ctrl) ++m_ctrl->refs;
    }
    void dec() noexcept {
        if (m_ctrl && --m_ctrl->refs == 0) {
            m_ctrl->dispose();
            delete m_ctrl;
        }
        m_ptr = nullptr;
        m_ctrl = nullptr;
    }

public:
    constexpr shared_ptr() noexcept = default;
    constexpr shared_ptr(nullptr_t) noexcept {}

    explicit shared_ptr(T* p) : m_ptr(p), m_ctrl(nullptr) {
        if (p) m_ctrl = new detail::sp_ctrl_del<T, default_delete<T>>(p, default_delete<T>{});
    }

    template <class Deleter>
    shared_ptr(T* p, Deleter d) : m_ptr(p), m_ctrl(nullptr) {
        if (p) m_ctrl = new detail::sp_ctrl_del<T, Deleter>(p, move(d));
    }

    shared_ptr(const shared_ptr& o) noexcept : m_ptr(o.m_ptr), m_ctrl(o.m_ctrl) { inc(); }
    shared_ptr(shared_ptr&& o) noexcept : m_ptr(o.m_ptr), m_ctrl(o.m_ctrl) {
        o.m_ptr = nullptr;
        o.m_ctrl = nullptr;
    }

    template <class U>
    shared_ptr(const shared_ptr<U>& o) noexcept : m_ptr(o.m_ptr), m_ctrl(o.m_ctrl) { inc(); }

    template <class U>
    shared_ptr(shared_ptr<U>&& o) noexcept : m_ptr(o.m_ptr), m_ctrl(o.m_ctrl) {
        o.m_ptr = nullptr;
        o.m_ctrl = nullptr;
    }

    ~shared_ptr() { dec(); }

    shared_ptr& operator=(const shared_ptr& o) noexcept {
        if (this != &o) {
            detail::sp_ctrl_base* old_ctrl = m_ctrl;
            T* o_ptr = o.m_ptr;
            detail::sp_ctrl_base* o_ctrl = o.m_ctrl;
            if (o_ctrl) ++o_ctrl->refs;
            m_ptr = o_ptr;
            m_ctrl = o_ctrl;
            if (old_ctrl && --old_ctrl->refs == 0) {
                old_ctrl->dispose();
                delete old_ctrl;
            }
        }
        return *this;
    }

    shared_ptr& operator=(shared_ptr&& o) noexcept {
        if (this != &o) {
            dec();
            m_ptr = o.m_ptr;
            m_ctrl = o.m_ctrl;
            o.m_ptr = nullptr;
            o.m_ctrl = nullptr;
        }
        return *this;
    }

    shared_ptr& operator=(nullptr_t) noexcept { reset(); return *this; }

    void reset() noexcept { dec(); }
    void reset(T* p) { *this = shared_ptr<T>(p); }
    template <class Deleter>
    void reset(T* p, Deleter d) { *this = shared_ptr<T>(p, move(d)); }

    T* get() const noexcept { return m_ptr; }
    T& operator*() const noexcept { return *m_ptr; }
    T* operator->() const noexcept { return m_ptr; }
    explicit operator bool() const noexcept { return m_ptr != nullptr; }
    long use_count() const noexcept { return m_ctrl ? m_ctrl->refs : 0; }
};

template <class T, class... Args>
shared_ptr<T> make_shared(Args&&... args) {
    auto* ctrl = new detail::sp_ctrl_obj<T>(forward<Args>(args)...);
    shared_ptr<T> sp;
    sp.m_ptr = ctrl->ptr();
    sp.m_ctrl = ctrl;
    return sp;
}

template <class T, class... Args>
unique_ptr<T> make_unique(Args&&... args) {
    return unique_ptr<T>(new T(forward<Args>(args)...));
}

template <class T, class U>
bool operator==(const shared_ptr<T>& a, const shared_ptr<U>& b) noexcept {
    return a.get() == b.get();
}
template <class T, class U>
bool operator!=(const shared_ptr<T>& a, const shared_ptr<U>& b) noexcept {
    return a.get() != b.get();
}
template <class T>
bool operator==(const shared_ptr<T>& a, nullptr_t) noexcept {
    return !a;
}
template <class T>
bool operator==(nullptr_t, const shared_ptr<T>& a) noexcept {
    return !a;
}
template <class T>
bool operator!=(const shared_ptr<T>& a, nullptr_t) noexcept {
    return static_cast<bool>(a);
}
template <class T>
bool operator!=(nullptr_t, const shared_ptr<T>& a) noexcept {
    return static_cast<bool>(a);
}

template <class T, class D1, class U, class D2>
bool operator==(const unique_ptr<T, D1>& a, const unique_ptr<U, D2>& b) noexcept {
    return a.get() == b.get();
}
template <class T, class D1, class U, class D2>
bool operator!=(const unique_ptr<T, D1>& a, const unique_ptr<U, D2>& b) noexcept {
    return a.get() != b.get();
}
template <class T, class D>
bool operator==(const unique_ptr<T, D>& a, nullptr_t) noexcept {
    return !a;
}
template <class T, class D>
bool operator==(nullptr_t, const unique_ptr<T, D>& a) noexcept {
    return !a;
}
template <class T, class D>
bool operator!=(const unique_ptr<T, D>& a, nullptr_t) noexcept {
    return static_cast<bool>(a);
}
template <class T, class D>
bool operator!=(nullptr_t, const unique_ptr<T, D>& a) noexcept {
    return static_cast<bool>(a);
}

} // namespace std
