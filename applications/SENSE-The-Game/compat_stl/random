#pragma once
#include <cstdint>
#include <limits>
extern "C" {
#include <system/timer.h>
}

namespace std {

class random_device {
public:
    using result_type = uint32_t;
    static constexpr result_type min() { return 0; }
    static constexpr result_type max() { return 0xFFFFFFFFu; }

    result_type operator()() {
        uint64_t tsc = read_tsc();
        uint32_t ms = timer_millis();
        uint32_t v = static_cast<uint32_t>(tsc ^ (tsc >> 32) ^ (static_cast<uint64_t>(ms) * 2654435761ULL));
        v ^= v >> 16;
        v *= 0x7feb352du;
        v ^= v >> 15;
        return v ? v : 0xA5A55A5Au;
    }
};

class mt19937 {
    uint64_t m_state = 0;

public:
    using result_type = uint32_t;
    static constexpr result_type min() { return 0; }
    static constexpr result_type max() { return 0xFFFFFFFFu; }

    explicit mt19937(uint32_t s = 5489u) { seed(s); }

    void seed(uint32_t s) {
        m_state = (static_cast<uint64_t>(s) * 0x9E3779B97F4A7C15ULL) ^ 0xBF58476D1CE4E5B9ULL;
        if (m_state == 0) m_state = 0x243F6A8885A308D3ULL;
    }

    result_type operator()() {
        uint64_t z = (m_state += 0x9E3779B97F4A7C15ULL);
        z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ULL;
        z = (z ^ (z >> 27)) * 0x94D049BB133111EBULL;
        return static_cast<result_type>(z ^ (z >> 31));
    }
};

template <class IntType = int>
class uniform_int_distribution {
    IntType m_a;
    IntType m_b;
public:
    using result_type = IntType;
    explicit uniform_int_distribution(IntType a = 0, IntType b = numeric_limits<IntType>::max())
        : m_a(a), m_b(b) {}

    template <class Gen>
    IntType operator()(Gen& g) const {
        if (m_b <= m_a) return m_a;
        uint64_t span = static_cast<uint64_t>(m_b) - static_cast<uint64_t>(m_a) + 1ULL;
        if (span <= 0x100000000ULL) {
            uint64_t prod = static_cast<uint64_t>(static_cast<uint32_t>(g())) * span;
            return static_cast<IntType>(m_a + static_cast<IntType>(prod >> 32));
        }
        uint64_t r = static_cast<uint64_t>(g()) | (static_cast<uint64_t>(g()) << 32);
        return static_cast<IntType>(m_a + static_cast<IntType>(r % span));
    }
};

} // namespace std
