#pragma once
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <iomanip>
#include <string>

namespace std {

class _StringStreamBase {
protected:
    string m_buf;
    size_t m_pos = 0;
    int m_width = 0;
    char m_fill = ' ';
    int m_prec = 6;
    bool m_fixed = false;
    bool m_eof = false;
    bool m_fail = false;

    void append_padded(const char* s, size_t len) {
        if (m_width > static_cast<int>(len)) {
            size_t pad = static_cast<size_t>(m_width) - len;
            for (size_t i = 0; i < pad; ++i) m_buf.push_back(m_fill);
        }
        m_buf.append(s, len);
        m_width = 0;
    }

public:
    explicit operator bool() const noexcept { return !m_fail; }
    bool eof() const noexcept { return m_eof; }
    bool fail() const noexcept { return m_fail; }

    string str() const { return m_buf; }
    void str(const string& s) {
        m_buf = s;
        m_pos = 0;
        m_eof = false;
        m_fail = false;
    }

    size_t _read_pos() const noexcept { return m_pos; }
    void _set_read_pos(size_t p) noexcept { m_pos = p; }
    void _set_eof(bool e) noexcept { m_eof = e; }
    void _set_fail(bool f) noexcept { m_fail = f; }
    const string& _raw() const noexcept { return m_buf; }
};

class istringstream : public _StringStreamBase {
public:
    istringstream() = default;
    explicit istringstream(const string& s) { str(s); }

    istringstream& operator>>(string& out) {
        out.clear();
        const string& s = m_buf;
        while (m_pos < s.size() && (s[m_pos] == ' ' || s[m_pos] == '\t' || s[m_pos] == '\n' || s[m_pos] == '\r')) {
            ++m_pos;
        }
        if (m_pos >= s.size()) {
            m_eof = true;
            m_fail = true;
            return *this;
        }
        size_t start = m_pos;
        while (m_pos < s.size() && s[m_pos] != ' ' && s[m_pos] != '\t' && s[m_pos] != '\n' && s[m_pos] != '\r') {
            ++m_pos;
        }
        out.assign(s.data() + start, m_pos - start);
        if (m_pos >= s.size()) m_eof = true;
        return *this;
    }
};

class ostringstream : public _StringStreamBase {
public:
    ostringstream() = default;
    explicit ostringstream(const string& s) { m_buf = s; }

    ostringstream& operator<<(_Setw w) { m_width = w.n; return *this; }
    ostringstream& operator<<(_Setfill f) { m_fill = f.c; return *this; }
    ostringstream& operator<<(_Setprecision p) { m_prec = p.n; return *this; }
    ostringstream& operator<<(_Ios_Manip) { m_fixed = true; return *this; }

    ostringstream& operator<<(const char* s) {
        const char* p = s ? s : "";
        append_padded(p, strlen(p));
        return *this;
    }
    ostringstream& operator<<(const string& s) {
        append_padded(s.data(), s.size());
        return *this;
    }
    ostringstream& operator<<(char c) {
        append_padded(&c, 1);
        return *this;
    }
    ostringstream& operator<<(int v) {
        char tmp[32];
        int n = snprintf(tmp, sizeof(tmp), "%d", v);
        if (n > 0) append_padded(tmp, static_cast<size_t>(n));
        return *this;
    }
    ostringstream& operator<<(unsigned int v) {
        char tmp[32];
        int n = snprintf(tmp, sizeof(tmp), "%u", v);
        if (n > 0) append_padded(tmp, static_cast<size_t>(n));
        return *this;
    }
    ostringstream& operator<<(long v) {
        char tmp[32];
        int n = snprintf(tmp, sizeof(tmp), "%ld", v);
        if (n > 0) append_padded(tmp, static_cast<size_t>(n));
        return *this;
    }
    ostringstream& operator<<(unsigned long v) {
        char tmp[32];
        int n = snprintf(tmp, sizeof(tmp), "%lu", v);
        if (n > 0) append_padded(tmp, static_cast<size_t>(n));
        return *this;
    }
    ostringstream& operator<<(long long v) {
        char tmp[32];
        int n = snprintf(tmp, sizeof(tmp), "%lld", v);
        if (n > 0) append_padded(tmp, static_cast<size_t>(n));
        return *this;
    }
    ostringstream& operator<<(unsigned long long v) {
        char tmp[32];
        int n = snprintf(tmp, sizeof(tmp), "%llu", v);
        if (n > 0) append_padded(tmp, static_cast<size_t>(n));
        return *this;
    }
    ostringstream& operator<<(double v) {
        char tmp[64];
        int n = snprintf(tmp, sizeof(tmp), m_fixed ? "%.*f" : "%.*g", m_prec, v);
        if (n > 0) append_padded(tmp, static_cast<size_t>(n));
        return *this;
    }
};

class stringstream : public ostringstream {
public:
    stringstream() = default;
    explicit stringstream(const string& s) : ostringstream(s) {}
};

inline bool getline(istringstream& ss, string& out, char delim = '\n') {
    out.clear();
    const string& s = ss._raw();
    size_t pos = ss._read_pos();
    if (pos >= s.size()) {
        ss._set_eof(true);
        ss._set_fail(true);
        return false;
    }
    size_t end = s.find(delim, pos);
    if (end == string::npos) {
        out.assign(s.data() + pos, s.size() - pos);
        ss._set_read_pos(s.size());
        ss._set_eof(true);
    } else {
        out.assign(s.data() + pos, end - pos);
        ss._set_read_pos(end + 1);
    }
    return true;
}

inline bool getline(stringstream& ss, string& out, char delim = '\n') {
    out.clear();
    const string& s = ss._raw();
    size_t pos = ss._read_pos();
    if (pos >= s.size()) {
        ss._set_eof(true);
        ss._set_fail(true);
        return false;
    }
    size_t end = s.find(delim, pos);
    if (end == string::npos) {
        out.assign(s.data() + pos, s.size() - pos);
        ss._set_read_pos(s.size());
        ss._set_eof(true);
    } else {
        out.assign(s.data() + pos, end - pos);
        ss._set_read_pos(end + 1);
    }
    return true;
}

} // namespace std
