#pragma once
#include <cstddef>
#include <cstdlib>
#include <cstring>
#include <cstdint>
#include <stdio.h>
#include <ctype.h>
#include <initializer_list>
#include <utility>

namespace std {

class string {
public:
    using value_type = char;
    using size_type = size_t;
    using iterator = char*;
    using const_iterator = const char*;
    static constexpr size_t npos = static_cast<size_t>(-1);

private:
    char* m_data = nullptr;
    size_t m_len = 0;
    size_t m_cap = 0;
    char m_sso[16] = {0};

    void init_empty() noexcept {
        m_data = m_sso;
        m_len = 0;
        m_cap = 15;
        m_sso[0] = '\0';
    }

    void ensure(size_t need) {
        if (need <= m_cap) return;
        size_t ncap = m_cap ? m_cap * 2 : 16;
        while (ncap < need) ncap *= 2;
        char* buf = static_cast<char*>(malloc(ncap + 1));
        if (!buf) return;
        if (m_len > 0) memcpy(buf, m_data, m_len);
        buf[m_len] = '\0';
        if (m_data != m_sso) free(m_data);
        m_data = buf;
        m_cap = ncap;
    }

public:
    string() noexcept { init_empty(); }

    string(const char* s) {
        init_empty();
        if (s) assign(s, strlen(s));
    }

    string(const char* s, size_t n) {
        init_empty();
        if (s && n) assign(s, n);
    }

    string(size_t n, char c) {
        init_empty();
        if (n) {
            ensure(n);
            memset(m_data, c, n);
            m_len = n;
            m_data[m_len] = '\0';
        }
    }

    string(const string& o) {
        init_empty();
        assign(o.m_data, o.m_len);
    }

    string(string&& o) noexcept {
        if (o.m_data == o.m_sso) {
            memcpy(m_sso, o.m_sso, o.m_len + 1);
            m_data = m_sso;
            m_len = o.m_len;
            m_cap = 15;
        } else {
            m_data = o.m_data;
            m_len = o.m_len;
            m_cap = o.m_cap;
        }
        o.init_empty();
    }

    ~string() {
        if (m_data && m_data != m_sso) free(m_data);
    }

    string& assign(const char* s, size_t n) {
        if (!s || n == 0) {
            clear();
            return *this;
        }
        ensure(n);
        memmove(m_data, s, n);
        m_len = n;
        m_data[m_len] = '\0';
        return *this;
    }

    string& operator=(const string& o) {
        if (this != &o) assign(o.m_data, o.m_len);
        return *this;
    }

    string& operator=(string&& o) noexcept {
        if (this != &o) {
            if (m_data && m_data != m_sso) free(m_data);
            if (o.m_data == o.m_sso) {
                memcpy(m_sso, o.m_sso, o.m_len + 1);
                m_data = m_sso;
                m_len = o.m_len;
                m_cap = 15;
            } else {
                m_data = o.m_data;
                m_len = o.m_len;
                m_cap = o.m_cap;
            }
            o.init_empty();
        }
        return *this;
    }

    string& operator=(const char* s) {
        return assign(s ? s : "", s ? strlen(s) : 0);
    }
    string& operator=(char c) {
        return assign(&c, 1);
    }

    const char* c_str() const noexcept { return m_data; }
    const char* data() const noexcept { return m_data; }
    char* data() noexcept { return m_data; }
    size_t size() const noexcept { return m_len; }
    size_t length() const noexcept { return m_len; }
    bool empty() const noexcept { return m_len == 0; }

    iterator begin() noexcept { return m_data; }
    iterator end() noexcept { return m_data + m_len; }
    const_iterator begin() const noexcept { return m_data; }
    const_iterator end() const noexcept { return m_data + m_len; }

    char& operator[](size_t i) noexcept { return m_data[i]; }
    const char& operator[](size_t i) const noexcept { return m_data[i]; }
    char& at(size_t i) noexcept { return m_data[i < m_len ? i : m_len]; }
    const char& at(size_t i) const noexcept { return m_data[i < m_len ? i : m_len]; }
    char& front() noexcept { return m_data[0]; }
    const char& front() const noexcept { return m_data[0]; }
    char& back() noexcept { return m_data[m_len - 1]; }
    const char& back() const noexcept { return m_data[m_len - 1]; }

    void reserve(size_t n) { ensure(n); }
    void clear() noexcept { m_len = 0; m_data[0] = '\0'; }

    void resize(size_t n, char c = '\0') {
        if (n < m_len) {
            m_len = n;
            m_data[m_len] = '\0';
        } else if (n > m_len) {
            ensure(n);
            memset(m_data + m_len, c, n - m_len);
            m_len = n;
            m_data[m_len] = '\0';
        }
    }

    void push_back(char c) {
        ensure(m_len + 1);
        m_data[m_len++] = c;
        m_data[m_len] = '\0';
    }

    void pop_back() noexcept {
        if (m_len > 0) m_data[--m_len] = '\0';
    }

    string& append(const char* s, size_t n) {
        if (s && n) {
            ensure(m_len + n);
            memcpy(m_data + m_len, s, n);
            m_len += n;
            m_data[m_len] = '\0';
        }
        return *this;
    }

    string& append(const char* s) { return s ? append(s, strlen(s)) : *this; }
    string& append(const string& o) { return append(o.m_data, o.m_len); }

    string& operator+=(const string& o) { return append(o); }
    string& operator+=(const char* s) { return append(s); }
    string& operator+=(char c) { push_back(c); return *this; }

    string& erase(size_t pos = 0, size_t count = npos) {
        if (pos >= m_len) return *this;
        size_t rem = m_len - pos;
        if (count >= rem) {
            m_len = pos;
            m_data[m_len] = '\0';
        } else if (count > 0) {
            memmove(m_data + pos, m_data + pos + count, rem - count);
            m_len -= count;
            m_data[m_len] = '\0';
        }
        return *this;
    }

    string substr(size_t pos = 0, size_t count = npos) const {
        if (pos >= m_len) return string();
        size_t n = m_len - pos;
        if (count < n) n = count;
        return string(m_data + pos, n);
    }

    size_t find(char c, size_t pos = 0) const noexcept {
        for (size_t i = pos; i < m_len; ++i) {
            if (m_data[i] == c) return i;
        }
        return npos;
    }

    size_t find(const char* s, size_t pos = 0) const noexcept {
        if (!s) return npos;
        size_t slen = strlen(s);
        if (slen == 0) return pos <= m_len ? pos : npos;
        if (pos + slen > m_len) return npos;
        for (size_t i = pos; i + slen <= m_len; ++i) {
            if (memcmp(m_data + i, s, slen) == 0) return i;
        }
        return npos;
    }

    size_t find(const string& s, size_t pos = 0) const noexcept {
        return find(s.c_str(), pos);
    }

    size_t find_first_not_of(const char* chars, size_t pos = 0) const noexcept {
        for (size_t i = pos; i < m_len; ++i) {
            if (!strchr(chars, m_data[i])) return i;
        }
        return npos;
    }

    size_t find_last_not_of(const char* chars, size_t pos = npos) const noexcept {
        if (m_len == 0) return npos;
        size_t i = (pos >= m_len) ? (m_len - 1) : pos;
        for (;;) {
            if (!strchr(chars, m_data[i])) return i;
            if (i == 0) break;
            --i;
        }
        return npos;
    }

    size_t rfind(char c, size_t pos = npos) const noexcept {
        if (m_len == 0) return npos;
        size_t i = (pos >= m_len) ? (m_len - 1) : pos;
        for (;;) {
            if (m_data[i] == c) return i;
            if (i == 0) break;
            --i;
        }
        return npos;
    }

    int compare(const string& o) const noexcept {
        return strcmp(m_data, o.m_data);
    }
    int compare(const char* s) const noexcept {
        return strcmp(m_data, s ? s : "");
    }
};

inline string operator+(const string& a, const string& b) {
    string r(a); r += b; return r;
}
inline string operator+(const string& a, const char* b) {
    string r(a); r += b; return r;
}
inline string operator+(const char* a, const string& b) {
    string r(a); r += b; return r;
}
inline string operator+(const string& a, char c) {
    string r(a); r += c; return r;
}
inline string operator+(char c, const string& b) {
    string r(1, c); r += b; return r;
}

inline bool operator==(const string& a, const string& b) noexcept {
    return a.size() == b.size() && memcmp(a.data(), b.data(), a.size()) == 0;
}
inline bool operator==(const string& a, const char* b) noexcept {
    return a.compare(b) == 0;
}
inline bool operator==(const char* a, const string& b) noexcept {
    return b.compare(a) == 0;
}
inline bool operator!=(const string& a, const string& b) noexcept { return !(a == b); }
inline bool operator!=(const string& a, const char* b) noexcept { return !(a == b); }
inline bool operator!=(const char* a, const string& b) noexcept { return !(a == b); }
inline bool operator<(const string& a, const string& b) noexcept { return a.compare(b) < 0; }
inline bool operator>(const string& a, const string& b) noexcept { return b < a; }
inline bool operator<=(const string& a, const string& b) noexcept { return !(b < a); }
inline bool operator>=(const string& a, const string& b) noexcept { return !(a < b); }

inline int stoi(const string& s, size_t* idx = nullptr, int base = 10) {
    char* end = nullptr;
    long v = strtol(s.c_str(), &end, base);
    if (idx) *idx = static_cast<size_t>(end - s.c_str());
    return static_cast<int>(v);
}

inline string to_string(int v) {
    char buf[32];
    snprintf(buf, sizeof(buf), "%d", v);
    return string(buf);
}

inline string to_string(long long v) {
    char buf[32];
    snprintf(buf, sizeof(buf), "%lld", v);
    return string(buf);
}

inline string to_string(unsigned int v) {
    char buf[32];
    snprintf(buf, sizeof(buf), "%u", v);
    return string(buf);
}

} // namespace std
