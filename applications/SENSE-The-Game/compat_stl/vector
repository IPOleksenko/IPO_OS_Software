#pragma once
#include <cstddef>
#include <cstdlib>
#include <initializer_list>
#include <new>
#include <utility>
#include <algorithm>

namespace std {

template <class T>
class vector {
public:
    using value_type = T;
    using size_type = size_t;
    using iterator = T*;
    using const_iterator = const T*;

private:
    T* m_data = nullptr;
    size_t m_size = 0;
    size_t m_cap = 0;

    void destroy_range(size_t from, size_t to) noexcept {
        for (size_t i = from; i < to; ++i) m_data[i].~T();
    }

    void reallocate(size_t new_cap) {
        T* buf = static_cast<T*>(operator new(new_cap * sizeof(T)));
        for (size_t i = 0; i < m_size; ++i) {
            ::new (static_cast<void*>(buf + i)) T(move(m_data[i]));
            m_data[i].~T();
        }
        operator delete(m_data);
        m_data = buf;
        m_cap = new_cap;
    }

public:
    vector() noexcept = default;

    explicit vector(size_t n, const T& val = T()) {
        reserve(n);
        for (size_t i = 0; i < n; ++i) ::new (static_cast<void*>(m_data + i)) T(val);
        m_size = n;
    }

    vector(initializer_list<T> il) {
        reserve(il.size());
        for (const auto& v : il) push_back(v);
    }

    vector(const vector& o) {
        reserve(o.m_size);
        for (size_t i = 0; i < o.m_size; ++i) {
            ::new (static_cast<void*>(m_data + i)) T(o.m_data[i]);
        }
        m_size = o.m_size;
    }

    vector(vector&& o) noexcept : m_data(o.m_data), m_size(o.m_size), m_cap(o.m_cap) {
        o.m_data = nullptr;
        o.m_size = 0;
        o.m_cap = 0;
    }

    ~vector() {
        clear();
        operator delete(m_data);
    }

    vector& operator=(const vector& o) {
        if (this != &o) {
            clear();
            reserve(o.m_size);
            for (size_t i = 0; i < o.m_size; ++i) {
                ::new (static_cast<void*>(m_data + i)) T(o.m_data[i]);
            }
            m_size = o.m_size;
        }
        return *this;
    }

    vector& operator=(vector&& o) noexcept {
        if (this != &o) {
            clear();
            operator delete(m_data);
            m_data = o.m_data;
            m_size = o.m_size;
            m_cap = o.m_cap;
            o.m_data = nullptr;
            o.m_size = 0;
            o.m_cap = 0;
        }
        return *this;
    }

    void reserve(size_t n) {
        if (n <= m_cap) return;
        size_t nc = m_cap ? m_cap * 2 : 8;
        while (nc < n) nc *= 2;
        reallocate(nc);
    }

    void resize(size_t n) {
        if (n < m_size) {
            destroy_range(n, m_size);
            m_size = n;
        } else if (n > m_size) {
            reserve(n);
            for (size_t i = m_size; i < n; ++i) ::new (static_cast<void*>(m_data + i)) T();
            m_size = n;
        }
    }

    void clear() noexcept {
        destroy_range(0, m_size);
        m_size = 0;
    }

    void push_back(const T& v) { emplace_back(v); }
    void push_back(T&& v) { emplace_back(move(v)); }

    template <class... Args>
    T& emplace_back(Args&&... args) {
        if (m_size == m_cap) reserve(m_cap ? m_cap * 2 : 8);
        ::new (static_cast<void*>(m_data + m_size)) T(forward<Args>(args)...);
        return m_data[m_size++];
    }

    void pop_back() noexcept {
        if (m_size > 0) m_data[--m_size].~T();
    }

    iterator erase(const_iterator pos) {
        size_t idx = static_cast<size_t>(pos - m_data);
        if (idx >= m_size) return end();
        for (size_t i = idx; i + 1 < m_size; ++i) m_data[i] = move(m_data[i + 1]);
        m_data[--m_size].~T();
        return m_data + idx;
    }

    iterator erase(const_iterator first, const_iterator last) {
        size_t f = static_cast<size_t>(first - m_data);
        size_t l = static_cast<size_t>(last - m_data);
        if (f >= l || f >= m_size) return m_data + f;
        if (l > m_size) l = m_size;
        size_t count = l - f;
        for (size_t i = f; i + count < m_size; ++i) m_data[i] = move(m_data[i + count]);
        destroy_range(m_size - count, m_size);
        m_size -= count;
        return m_data + f;
    }

    size_t size() const noexcept { return m_size; }
    bool empty() const noexcept { return m_size == 0; }
    T* data() noexcept { return m_data; }
    const T* data() const noexcept { return m_data; }
    T& operator[](size_t i) noexcept { return m_data[i]; }
    const T& operator[](size_t i) const noexcept { return m_data[i]; }
    T& front() noexcept { return m_data[0]; }
    const T& front() const noexcept { return m_data[0]; }
    T& back() noexcept { return m_data[m_size - 1]; }
    const T& back() const noexcept { return m_data[m_size - 1]; }
    iterator begin() noexcept { return m_data; }
    iterator end() noexcept { return m_data + m_size; }
    const_iterator begin() const noexcept { return m_data; }
    const_iterator end() const noexcept { return m_data + m_size; }
    const_iterator cbegin() const noexcept { return m_data; }
    const_iterator cend() const noexcept { return m_data + m_size; }
};

} // namespace std
