#pragma once
#include_next <cmath>

namespace std {
inline double round(double x) { return (x >= 0.0) ? floor(x + 0.5) : ceil(x - 0.5); }
inline float round(float x) { return static_cast<float>(round(static_cast<double>(x))); }
inline double hypot(double x, double y) { return sqrt(x * x + y * y); }
inline float hypot(float x, float y) { return static_cast<float>(sqrt(static_cast<double>(x) * x + static_cast<double>(y) * y)); }
inline float abs(float x) { return (x < 0.0f) ? -x : x; }
inline double abs(double x) { return (x < 0.0) ? -x : x; }
} // namespace std
