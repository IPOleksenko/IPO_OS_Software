#ifndef _CPP_STRING_H
#define _CPP_STRING_H

#include <stddef.h>
#include <string.h>
#include <stdlib.h>
#include <iostream>
#include <utility>
#include <new>

namespace std {

class string {
private:
    char *m_data;
    size_t m_len;
    size_t m_cap;

    static void oom_fail() {
#ifdef __EXCEPTIONS
        throw bad_alloc();
#else
        abort();
#endif
    }

    void ensure_cap(size_t need) {
        if (need + 1u <= m_cap && m_data) return;
        size_t new_cap = m_cap ? m_cap : 16u;
        while (new_cap < need + 1u) {
            if (new_cap > ((size_t)-1) / 2u) {
                new_cap = need + 1u;
                break;
            }
            new_cap *= 2u;
        }
        char *nb = (char *)realloc(m_data, new_cap);
        if (!nb) oom_fail();
        m_data = nb;
        m_cap = new_cap;
    }

public:
    static const size_t npos = (size_t)-1;

    string() : m_data(nullptr), m_len(0), m_cap(0) {
        m_data = (char *)malloc(16u);
        if (!m_data) oom_fail();
        m_cap = 16u;
        m_data[0] = '\0';
    }

    string(const char *s) : m_data(nullptr), m_len(0), m_cap(0) {
        size_t len = s ? strlen(s) : 0u;
        size_t cap = (len + 1u > 16u) ? (len + 1u) : 16u;
        m_data = (char *)malloc(cap);
        if (!m_data) oom_fail();
        m_cap = cap;
        m_len = len;
        if (len > 0u) memcpy(m_data, s, len);
        m_data[len] = '\0';
    }

    string(const char *s, size_t n) : m_data(nullptr), m_len(0), m_cap(0) {
        size_t cap = (n + 1u > 16u) ? (n + 1u) : 16u;
        m_data = (char *)malloc(cap);
        if (!m_data) oom_fail();
        m_cap = cap;
        m_len = n;
        if (n > 0u && s) memcpy(m_data, s, n);
        m_data[n] = '\0';
    }

    string(const string &other) : m_data(nullptr), m_len(other.m_len), m_cap(0) {
        size_t cap = (other.m_len + 1u > 16u) ? (other.m_len + 1u) : 16u;
        m_data = (char *)malloc(cap);
        if (!m_data) oom_fail();
        m_cap = cap;
        if (m_len > 0u && other.m_data) memcpy(m_data, other.m_data, m_len);
        m_data[m_len] = '\0';
    }

    string(string &&other) noexcept
        : m_data(other.m_data), m_len(other.m_len), m_cap(other.m_cap) {
        other.m_data = nullptr;
        other.m_len = 0u;
        other.m_cap = 0u;
    }

    ~string() {
        free(m_data);
    }

    string& operator=(const string &other) {
        if (this != &other) {
            char *nb = (char *)malloc(other.m_len + 1u);
            if (!nb) oom_fail();
            if (other.m_len > 0u && other.m_data) {
                memcpy(nb, other.m_data, other.m_len);
            }
            nb[other.m_len] = '\0';
            free(m_data);
            m_data = nb;
            m_len = other.m_len;
            m_cap = other.m_len + 1u;
        }
        return *this;
    }

    string& operator=(string &&other) noexcept {
        if (this != &other) {
            free(m_data);
            m_data = other.m_data;
            m_len = other.m_len;
            m_cap = other.m_cap;
            other.m_data = nullptr;
            other.m_len = 0u;
            other.m_cap = 0u;
        }
        return *this;
    }

    string& operator=(const char *s) {
        size_t len = s ? strlen(s) : 0u;
        ensure_cap(len);
        if (len > 0u && s) memmove(m_data, s, len);
        m_len = len;
        m_data[m_len] = '\0';
        return *this;
    }

    void reserve(size_t new_cap) {
        if (new_cap + 1u > m_cap) {
            ensure_cap(new_cap);
        }
    }

    void clear() noexcept {
        m_len = 0u;
        if (m_data) m_data[0] = '\0';
    }

    void push_back(char c) {
        ensure_cap(m_len + 1u);
        m_data[m_len++] = c;
        m_data[m_len] = '\0';
    }

    string& append(const char *s, size_t n) {
        if (!s || n == 0u) return *this;
        ensure_cap(m_len + n);
        memcpy(m_data + m_len, s, n);
        m_len += n;
        m_data[m_len] = '\0';
        return *this;
    }

    string& append(const char *s) {
        return s ? append(s, strlen(s)) : *this;
    }

    string& append(const string &other) {
        return append(other.c_str(), other.m_len);
    }

    string& operator+=(const string &other) { return append(other); }
    string& operator+=(const char *s) { return append(s); }
    string& operator+=(char c) { push_back(c); return *this; }

    string substr(size_t pos = 0u, size_t count = npos) const {
        if (pos >= m_len) return string();
        size_t rem = m_len - pos;
        size_t take = (count < rem) ? count : rem;
        return string(c_str() + pos, take);
    }

    size_t find(const char *s, size_t pos = 0u) const {
        if (!s || pos > m_len) return npos;
        const char *base = c_str();
        const char *hit = strstr(base + pos, s);
        return hit ? (size_t)(hit - base) : npos;
    }

    size_t find(char c, size_t pos = 0u) const {
        const char *base = c_str();
        for (size_t i = pos; i < m_len; i++) {
            if (base[i] == c) return i;
        }
        return npos;
    }

    int compare(const string &other) const noexcept {
        return strcmp(c_str(), other.c_str());
    }

    int compare(const char *s) const noexcept {
        return strcmp(c_str(), s ? s : "");
    }

    size_t length() const noexcept { return m_len; }
    size_t size() const noexcept { return m_len; }
    size_t capacity() const noexcept { return m_cap > 0u ? m_cap - 1u : 0u; }
    bool empty() const noexcept { return m_len == 0u; }
    const char* c_str() const noexcept { return m_data ? m_data : ""; }
    const char* data() const noexcept { return c_str(); }
    char* data() noexcept { return m_data; }

    char* begin() noexcept { return m_data; }
    char* end() noexcept { return m_data ? (m_data + m_len) : nullptr; }
    const char* begin() const noexcept { return c_str(); }
    const char* end() const noexcept { return c_str() + m_len; }

    char& operator[](size_t idx) { return m_data[idx]; }
    const char& operator[](size_t idx) const { return c_str()[idx]; }
};

inline string operator+(const string &a, const string &b) {
    string res;
    res.reserve(a.length() + b.length());
    res.append(a);
    res.append(b);
    return res;
}

inline string operator+(const string &a, const char *b) {
    string res(a);
    res.append(b);
    return res;
}

inline bool operator==(const string &a, const string &b) noexcept {
    return a.length() == b.length() && memcmp(a.c_str(), b.c_str(), a.length()) == 0;
}

inline bool operator==(const string &a, const char *b) noexcept {
    return strcmp(a.c_str(), b ? b : "") == 0;
}

inline bool operator!=(const string &a, const string &b) noexcept { return !(a == b); }
inline bool operator!=(const string &a, const char *b) noexcept { return !(a == b); }
inline bool operator<(const string &a, const string &b) noexcept { return a.compare(b) < 0; }

inline ostream& operator<<(ostream& os, const string& s) {
    return os << s.c_str();
}

} // namespace std

#endif
